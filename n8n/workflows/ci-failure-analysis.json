{
  "name": "CI Failure Analysis Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-failure",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - CI Failure",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "ci-failure-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:3000/api/analyze",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "failure_log",
              "value": "={{ $json.body.log }}"
            },
            {
              "name": "repository",
              "value": "={{ $json.body.repository }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-openai",
      "name": "HTTP Request - OpenAI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://slack-bot:3001/slack/message",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'devops-alert', analysis: { repository: $json.repository, confidence: $json.confidence || 0.5, analysis: $json.analysis || 'Analysis unavailable', identified_cause: $json.identified_cause || '', recommended_actions: $json.recommended_actions || [] } }) }}",
        "options": {}
      },
      "id": "http-request-slack",
      "name": "HTTP Request - Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Get the analysis from previous node and PR numbers from webhook\nconst analysis = $('HTTP Request - OpenAI Analysis').first().json;\nconst webhookData = $('Webhook - CI Failure').first().json.body;\n\n// Get PR numbers (may be empty array)\nconst pullRequests = webhookData.pullRequests || [];\n\n// If no PRs, return empty array (skip GitHub posting)\nif (pullRequests.length === 0) {\n  return [];\n}\n\n// Return items for each PR to post comment to\nreturn pullRequests.map(prNumber => ({\n  json: {\n    repository: analysis.repository,\n    pr_number: prNumber,\n    analysis: {\n      analysis: analysis.analysis,\n      identified_cause: analysis.identified_cause,\n      confidence: analysis.confidence,\n      recommended_actions: analysis.recommended_actions\n    }\n  }\n}));"
      },
      "id": "code-prepare-github",
      "name": "Prepare GitHub Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://github-app:3002/api/github/comment",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ repository: $json.repository, pr_number: $json.pr_number, analysis: $json.analysis }) }}",
        "options": {}
      },
      "id": "http-request-github",
      "name": "HTTP Request - Post to GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"processed\", \"slack_notified\": true, \"github_comments\": $('HTTP Request - Post to GitHub').all().length } }}"
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 400]
    }
  ],
