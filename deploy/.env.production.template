# ============================================================
# Kenchi Production Environment Variables
#
# Copy this file to /opt/kenchi/.env on the VPS and fill in
# real values. NEVER commit the actual .env file.
#
# Usage: cp deploy/.env.production.template /opt/kenchi/.env
# ============================================================

# ==================== Database ====================
# Strong password for production Postgres (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ==================== LLM Provider ====================
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-openrouter-key
LLM_MODEL=moonshotai/kimi-k2.5
EXTRACTION_MODEL=anthropic/claude-3.5-haiku

# OpenAI (fallback / fine-tuning)
OPENAI_API_KEY=your-openai-api-key

# ==================== Slack ====================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_LEVEL_TOKEN=xapp-your-slack-app-level-token

# ==================== GitHub App ====================
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_INSTALLATION_ID=your-github-installation-id
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_SLUG=kenchi-devops

# ==================== GitHub OAuth ====================
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# ==================== GitLab OAuth ====================
GITLAB_OAUTH_CLIENT_ID=your-gitlab-oauth-client-id
GITLAB_OAUTH_CLIENT_SECRET=your-gitlab-oauth-client-secret

# ==================== Security ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTE_HEX

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX

# Internal service-to-service HMAC
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_32_BYTE_HEX

# ==================== Application ====================
NODE_ENV=production
PORT=3000

# ==================== Monitoring Webhooks (optional) ====================
# PAGERDUTY_WEBHOOK_SECRET=
# DATADOG_WEBHOOK_SECRET=
# GRAFANA_WEBHOOK_SECRET=
# PROMETHEUS_WEBHOOK_SECRET=
# SLACK_INCIDENT_WEBHOOK_URL=
