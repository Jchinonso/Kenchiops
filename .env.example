# LLM Provider Configuration
# Set LLM_PROVIDER to switch between providers: "openai" (default) or "openrouter"
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_MODEL=google/gemini-2.5-flash
# EXTRACTION_MODEL=google/gemini-2.5-flash

# OpenAI Configuration (fallback if LLM_* not set)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-2024-04-09
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_MS=30000

# Slack Configuration
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_LEVEL_TOKEN=your-slack-app-level-token

# GitHub App Configuration
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_INSTALLATION_ID=your-github-installation-id
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# OAuth & Authentication
# FRONTEND_URL — Where the frontend is served from. Used for CORS origin and post-auth redirects.
# OAUTH_CALLBACK_BASE_URL — Where OAuth providers redirect after authorization.
#   Local dev (Vite): defaults to http://localhost:5173 — no change needed
#   Docker local: set in docker-compose.yml to http://localhost:3003
#   Remote/production: set both to your public URL (e.g., https://app.kenchi.dev)
# FRONTEND_URL=https://app.kenchi.dev
# OAUTH_CALLBACK_BASE_URL=https://app.kenchi.dev
# JWT_SECRET=your-jwt-secret-min-32-chars
# ENCRYPTION_KEY — 32-byte hex key for AES-256-GCM encryption of OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in dev (tokens stored in plaintext if unset). Required in production.
# ENCRYPTION_KEY=

# GitHub OAuth (required for user auth)
# GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# GitLab OAuth (optional)
# GITLAB_OAUTH_CLIENT_ID=your-gitlab-oauth-client-id
# GITLAB_OAUTH_CLIENT_SECRET=your-gitlab-oauth-client-secret

# Bitbucket OAuth (optional)
# BITBUCKET_OAUTH_CLIENT_ID=your-bitbucket-oauth-client-id
# BITBUCKET_OAUTH_CLIENT_SECRET=your-bitbucket-oauth-client-secret

# Azure DevOps OAuth (optional)
# AZURE_DEVOPS_OAUTH_CLIENT_ID=your-azure-devops-oauth-client-id
# AZURE_DEVOPS_OAUTH_CLIENT_SECRET=your-azure-devops-oauth-client-secret

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/kenchi
VECTOR_DB_URL=postgres://user:password@localhost:5432/kenchi_vector

# Application Configuration
NODE_ENV=development
PORT=3000
