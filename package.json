{
  "name": "kenchi-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "AI-driven DevOps assistant monorepo (scaffold)",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "build:shared": "npm --workspace packages/shared run build",
    "build:api": "npm run build:shared && npm --workspace services/api run build",
    "build:slack-bot": "npm run build:shared && npm --workspace services/slack-bot run build",
    "build:github-app": "npm run build:shared && npm --workspace services/github-app run build",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "jest",
    "test:ci": "jest --maxWorkers=2 --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --coverage --maxWorkers=2 --forceExit",
    "dev:api": "npm run build:shared && npm --workspace services/api run dev",
    "dev:slack-bot": "npm run build:shared && npm --workspace services/slack-bot run dev",
    "dev:github-app": "npm run build:shared && npm --workspace services/github-app run dev",
    "dev:frontend": "npm --workspace services/frontend run dev",
    "build:frontend": "npm --workspace services/frontend run build",
    "clean": "npm run clean --workspaces --if-present",
    "type-check": "tsc --build --force",
    "validate": "tsx scripts/validate-env.ts",
    "check-build": "tsx scripts/check-build.ts",
    "check:duplication": "tsx scripts/check-duplication.ts",
    "check:standards": "node scripts/check-standards.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
